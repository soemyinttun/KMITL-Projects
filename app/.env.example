# Copy to app/.env.local for local testing with the cloud database, or set these in
# Vercel → Project → Settings → Environment Variables. Both values are in Supabase →
# Project Settings → API. Leave them out to run the app in local-only mode.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
